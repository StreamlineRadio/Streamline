#!/bin/sh

if ! pnpm commitlint --edit "$1"; then
  echo ""
  echo "┌─────────────────────────────────────────────────────────────┐"
  echo "│               Commit message format invalid!                │"
  echo "└─────────────────────────────────────────────────────────────┘"
  echo ""
  echo "  Commits must follow the Conventional Commits format:"
  echo ""
  echo "    <type>(<scope>): <description>"
  echo ""
  echo "  Examples:"
  echo "    feat(audio): add crossfade support"
  echo "    fix(ipc): handle null device on reconnect"
  echo "    chore: update dependencies"
  echo "    docs: document IPC handler API"
  echo ""
  echo "  Allowed types:"
  echo "    feat     – new feature"
  echo "    fix      – bug fix"
  echo "    chore    – maintenance, tooling, deps"
  echo "    docs     – documentation only"
  echo "    style    – formatting, no logic change"
  echo "    refactor – code change, no feature or fix"
  echo "    test     – adding or fixing tests"
  echo "    build    – build system or external deps"
  echo "    ci       – CI/CD configuration"
  echo "    perf     – performance improvement"
  echo "    revert   – reverts a previous commit"
  echo ""
  exit 1
fi