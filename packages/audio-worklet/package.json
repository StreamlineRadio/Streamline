{
	"name": "@streamline/audio-worklet",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./tap-processor": "./src/tap-processor.ts"
	},
	"lint-staged": {
		"*.{ts,js,mjs,cjs}": [
			"prettier --write",
			"eslint --fix --quiet"
		],
		"*.{json,css,html,md,yaml,yml}": "prettier --write"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"lint": "prettier --check . && eslint --quiet .",
		"lint:fix": "prettier --write . && eslint --fix .",
		"format": "prettier --write .",
		"test": "vitest run"
	},
	"dependencies": {
		"@streamline/shared": "workspace:*"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/audioworklet": "^0.0.100",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.6.0",
		"lint-staged": "^17.0.4",
		"prettier": "^3.8.1",
		"typescript": "^5.8.0",
		"typescript-eslint": "^8.59.4",
		"vitest": "^2.0.0"
	}
}
