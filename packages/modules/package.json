{
	"name": "@streamline/modules",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"lint-staged": {
		"*.{ts,js,mjs,cjs}": [
			"prettier --write",
			"eslint --fix --quiet"
		],
		"*.{json,css,html,md,yaml,yml}": "prettier --write"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"lint": "prettier --check . && eslint --quiet .",
		"lint:fix": "prettier --write . && eslint --fix .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@streamline/shared": "workspace:*"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.6.0",
		"prettier": "^3.8.1",
		"typescript": "^5.8.0",
		"typescript-eslint": "^8.59.2"
	}
}
