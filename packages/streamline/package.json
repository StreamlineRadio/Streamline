{
	"name": "streamline",
	"productName": "Streamline",
	"version": "0.0.1",
	"description": "Streamline - the free open-source radio broadcasting application",
	"main": ".vite/build/main.js",
	"private": true,
	"scripts": {
		"postinstall": "cd ../.. && electron-rebuild -f -w better-sqlite3",
		"dev": "electron-forge start",
		"start": "electron-forge start",
		"make": "electron-forge make",
		"check": "svelte-check --tsconfig ./renderer/tsconfig.json && tsc --noEmit",
		"test": "vitest run",
		"lint": "prettier --check . && eslint --quiet .",
		"lint:fix": "prettier --write . && eslint --fix .",
		"format": "prettier --write ."
	},
	"lint-staged": {
		"*.{ts,js,mjs,cjs,svelte}": [
			"prettier --write",
			"eslint --fix --quiet"
		],
		"*.{json,css,html,md,yaml,yml}": "prettier --write"
	},
	"keywords": [],
	"author": {
		"name": "Robbin \"Roboroads\" Schepers",
		"email": "robbin+streamline@deschepers.nl"
	},
	"license": "AGPL-3.0-only",
	"dependencies": {
		"@fortawesome/fontawesome-svg-core": "^7.2.0",
		"@fortawesome/free-brands-svg-icons": "^7.2.0",
		"@fortawesome/free-regular-svg-icons": "^7.2.0",
		"@fortawesome/free-solid-svg-icons": "^7.2.0",
		"@fortawesome/svelte-fontawesome": "^0.2.4",
		"@streamline/audio-worklet": "workspace:*",
		"@streamline/modules": "workspace:*",
		"@streamline/shared": "workspace:*",
		"better-sqlite3": "^12.10.0",
		"chokidar": "^5.0.0",
		"drizzle-orm": "^0.45.2",
		"electron-log": "^5.4.3",
		"electron-window-state": "^5.0.3",
		"ffmpeg-static": "^5.3.0",
		"interactjs": "^1.10.27",
		"music-metadata": "^11.12.3",
		"wavesurfer.js": "^7.12.6"
	},
	"devDependencies": {
		"@electron-forge/cli": "^7.11.1",
		"@electron-forge/maker-deb": "^7.11.1",
		"@electron-forge/maker-dmg": "^7.11.1",
		"@electron-forge/maker-rpm": "^7.11.1",
		"@electron-forge/maker-squirrel": "^7.11.1",
		"@electron-forge/maker-zip": "^7.11.1",
		"@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
		"@electron-forge/plugin-fuses": "^7.11.1",
		"@electron-forge/plugin-vite": "^7.11.1",
		"@electron/fuses": "^1.0.0",
		"@eslint/js": "^10.0.1",
		"@interactjs/types": "^1.10.27",
		"@reforged/maker-appimage": "^5.2.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/electron-window-state": "^2.0.0",
		"@types/node": "^22.0.0",
		"drizzle-kit": "^0.31.10",
		"electron": "42.0.1",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.8.0",
		"typescript-eslint": "^8.59.3",
		"vite": "^5.4.21",
		"vite-plugin-static-copy": "^1.0.6",
		"vitest": "^2.0.0"
	}
}
